# GovSim AI Environment Configuration

# Google Gemini API Key (Required for natural language policy parsing & macroeconomic critique)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Identifier (Defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# API Gateway Configuration
PORT=3000
FISCAL_ENGINE_URL=http://localhost:8000
UPSTREAM_TIMEOUT_MS=120000

# Logging level
LOG_LEVEL=INFO
