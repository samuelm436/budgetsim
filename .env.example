# GovSim AI Environment Configuration

# Google Gemini API Key (Required for natural language policy parsing & macroeconomic critique)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Identifier (gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# API Gateway Configuration
PORT=3000
FISCAL_ENGINE_URL=http://localhost:8000
UPSTREAM_TIMEOUT_MS=120000

# SQLite Cloud Database Path (Single self-contained database file for portability)
DB_PATH=./data/govsim.sqlite3

# JWT Authentication Secret
JWT_SECRET=govsim-ai-secret-key-change-in-production

# Keycloak Open Source IAM (Optional / Enterprise OIDC)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=govsim
KEYCLOAK_CLIENT_ID=govsim-web

# Logging level
LOG_LEVEL=INFO
