# GovSim AI Environment Configuration

# Active AI Model Identifier (default: gpt-6-luna)
ACTIVE_MODEL=gpt-6-luna

# OpenAI API Key (Required for GPT-6-Luna, GPT-4o, and OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Required for Gemini models)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Identifier (gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# API Gateway Configuration
PORT=3000
FISCAL_ENGINE_URL=http://localhost:8000
UPSTREAM_TIMEOUT_MS=120000

# SQLite Cloud Database Path (Single self-contained database file for portability)
DB_PATH=./data/govsim.sqlite3

# JWT Authentication Secret
JWT_SECRET=govsim-ai-secret-key-change-in-production

# Keycloak Open Source IAM (Optional / Enterprise OIDC)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=govsim
KEYCLOAK_CLIENT_ID=govsim-web

# Logging level
LOG_LEVEL=INFO
